      "title": "Rotation Success Rate",
      "type": "stat",
      "targets": [{ "expr": "100 - (sum(rate(secretvault_rotation_failed_total[1h])) / sum(rate(secretvault_rotation_completed_total[1h]) + 0.001) * 100)", "refId": "A" }]
