      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 4 },
      "id": 3,
      "title": "5xx Error Rate (%)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m])) * 100", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
