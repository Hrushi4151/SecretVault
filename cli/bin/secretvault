#!/usr/bin/env bash
# SecretVault CLI launcher for macOS and Linux
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_JAR="$DIR/../target/secretvault.jar"

if [ ! -f "$CLI_JAR" ]; then
    # Fallback search
    CLI_JAR="$DIR/../target/secretvault-cli-1.0.0.jar"
fi

if [ ! -f "$CLI_JAR" ]; then
    echo "ERROR: SecretVault CLI JAR not found at $CLI_JAR. Please build with 'mvn clean package -DskipTests' in cli/ directory." >&2
    exit 1
fi

exec java -jar "$CLI_JAR" "$@"
