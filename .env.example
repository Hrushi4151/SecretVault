# ==============================================================================
# SecretVault — Local Development Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT. NEVER COMMIT .env TO GIT.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secretvault_dev
DB_USER=vault_user
DB_PASSWORD=vault_secure_password_dev_only

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Master Encryption Key (For local dev only; use KMS/HSM in staging/production)
# 256-bit AES Key (base64 encoded 32 bytes)
VAULT_MASTER_KEY=dGVzdF9tYXN0ZXJfa2V5XzMyX2J5dGVzX2Zvcl9sb2NhbF9kZXY=
JWT_SECRET=super_secret_jwt_signing_key_for_local_development_only_minimum_256_bits_length

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Level
LOG_LEVEL_SECRETVault=DEBUG
LOG_LEVEL_ROOT=INFO
